rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Name catalogue: public read, written only by admins / Cloud Functions.
    match /names/{nameId} {
      allow read: if true;
      allow write: if false;
    }

    // Each user's favorites (anonymous accounts included).
    match /users/{uid}/favorites/{nameId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.name_id == nameId
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.updated_at is timestamp
        && request.resource.data.deleted is bool;
    }

    // "Suggest a name": create-only, nobody reads from the app.
    match /suggestions/{id} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name_latin', 'name_geez',
             'meaning', 'note', 'language', 'created_at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name_latin is string
        && request.resource.data.name_latin.size() >= 1
        && request.resource.data.name_latin.size() <= 60
        && request.resource.data.name_geez.size() <= 60
        && request.resource.data.meaning.size() <= 500
        && request.resource.data.note.size() <= 500
        && request.resource.data.language in ['en', 'am']
        && request.resource.data.created_at == request.time;
    }

    // Name of the day, written by the nameOfTheDay function.
    match /daily/{date} {
      allow read: if true;
      allow write: if false;
    }

    // "Coming soon" AI waitlist: create your own entry only; nobody reads
    // from the app (export via the console / Admin SDK).
    match /ai_waitlist/{entryId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['uid', 'text', 'language', 'features', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['uid', 'text', 'language', 'features', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.language in ['en', 'am']
        && request.resource.data.features is list
        && request.resource.data.features.size() >= 1
        && request.resource.data.features.size() <= 2
        && request.resource.data.features.hasOnly(
             ['name_finder', 'face_preview'])
        && request.resource.data.createdAt == request.time;
    }

    // Family vote: owners create from the app; family vote on the web page.
    match /votes/{voteId} {
      function isOwner() {
        return signedIn() && resource.data.owner_uid == request.auth.uid;
      }
      allow get: if true; // anyone with the (unguessable) link
      allow list: if signedIn() && resource.data.owner_uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['owner_uid', 'title', 'options', 'option_ids', 'open', 'created_at'])
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 6
        && request.resource.data.option_ids is list
        && request.resource.data.option_ids.size() == request.resource.data.options.size()
        && request.resource.data.open == true
        && request.resource.data.created_at == request.time;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open']);
      allow delete: if isOwner();

      // One ballot per device: the ballot id must be the voter's (anonymous)
      // uid, and ballots can be created once but never changed.
      match /ballots/{ballotId} {
        function vote() {
          return get(/databases/$(database)/documents/votes/$(voteId)).data;
        }
        allow get: if signedIn()
          && (ballotId == request.auth.uid || vote().owner_uid == request.auth.uid);
        allow list: if signedIn() && vote().owner_uid == request.auth.uid;
        allow create: if signedIn()
          && ballotId == request.auth.uid
          && vote().open == true
          && request.resource.data.keys().hasOnly(['voter_name', 'choice', 'created_at'])
          && request.resource.data.voter_name is string
          && request.resource.data.voter_name.size() >= 1
          && request.resource.data.voter_name.size() <= 40
          && request.resource.data.choice in vote().option_ids
          && request.resource.data.created_at == request.time;
        allow update, delete: if false;
      }
    }

    // Partner link: couples/{6-digit code}.
    match /couples/{code} {
      function members() {
        return resource.data.members;
      }
      function isMember() {
        return signedIn() && request.auth.uid in members();
      }

      // Anyone signed in may look up one code (to join it), never list.
      allow get: if signedIn();
      allow list: if false;

      // Create: you are the only member and the doc id is the code.
      allow create: if signedIn()
        && code.matches('^[0-9]{6}$')
        && request.resource.data.code == code
        && request.resource.data.members == [request.auth.uid];

      // Join (add yourself to a 1-member couple) or leave (remove yourself).
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members'])
        && (
          (members().size() == 1
            && !(request.auth.uid in members())
            && request.resource.data.members ==
                 members().concat([request.auth.uid]))
          ||
          (isMember()
            && request.resource.data.members ==
                 members().removeAll([request.auth.uid]))
        );

      function coupleMember() {
        return signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/couples/$(code)).data.members;
      }

      // Likes: members write their own (doc id = uid_nameId), members read.
      match /likes/{likeId} {
        allow read: if coupleMember();
        allow create: if coupleMember()
          && request.resource.data.uid == request.auth.uid
          && likeId == request.auth.uid + '_' + request.resource.data.name_id
          && request.resource.data.super is bool;
        allow delete: if coupleMember()
          && resource.data.uid == request.auth.uid;
      }

      // Matches are written by the onSwipe Cloud Function only.
      match /matches/{nameId} {
        allow read: if coupleMember();
        allow write: if false;
      }
    }
  }
}
